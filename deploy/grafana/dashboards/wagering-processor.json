{
  "title": "Wagering Processor",
  "uid": "wagering-processor",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "5s",
  "tags": ["wagering-processor"],
  "panels": [
    {
      "id": 1,
      "title": "Profundidade da DLQ",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "value" },
      "targets": [{ "expr": "max(wager_transactions_dlq_depth)", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Conflitos de lock (5min)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "value" },
      "targets": [{ "expr": "sum(increase(wager_transactions_lock_conflicts_total[5m]))", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Duplicatas detectadas (5min)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "value" },
      "targets": [{ "expr": "sum(increase(wager_transactions_duplicate_deliveries_total[5m])) + sum(increase(wager_transactions_replays_total[5m]))", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Divergências de reconciliação (total)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "value" },
      "targets": [{ "expr": "sum(wallet_reconciliation_divergence_total)", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "Transações por status (taxa)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [{ "expr": "sum by (status, channel) (rate(wager_transactions_total[1m]))", "legendFormat": "{{status}} ({{channel}})", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "Retries por motivo",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [{ "expr": "sum by (reason) (rate(wager_transactions_retries_total[1m]))", "legendFormat": "{{reason}}", "refId": "A" }]
    },
    {
      "id": 7,
      "title": "Consumo SQS por outcome",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [{ "expr": "sum by (outcome) (rate(wager_transactions_consumed_total[1m]))", "legendFormat": "{{outcome}}", "refId": "A" }]
    },
    {
      "id": 8,
      "title": "Latência de processamento (p50/p95/p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, channel) (rate(wager_transaction_processing_duration_ms_bucket[5m])))", "legendFormat": "p50 ({{channel}})", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, channel) (rate(wager_transaction_processing_duration_ms_bucket[5m])))", "legendFormat": "p95 ({{channel}})", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le, channel) (rate(wager_transaction_processing_duration_ms_bucket[5m])))", "legendFormat": "p99 ({{channel}})", "refId": "C" }
      ]
    },
    {
      "id": 9,
      "title": "Outbox publish lag (p50/p95/p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(outbox_publish_lag_ms_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(outbox_publish_lag_ms_bucket[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(outbox_publish_lag_ms_bucket[5m])))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 10,
      "title": "Replays (idempotência) por canal",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [{ "expr": "sum by (channel) (rate(wager_transactions_replays_total[1m]))", "legendFormat": "{{channel}}", "refId": "A" }]
    },
    {
      "id": 11,
      "title": "Profundidade da DLQ ao longo do tempo",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [{ "expr": "wager_transactions_dlq_depth", "legendFormat": "{{instance}}", "refId": "A" }]
    }
  ]
}
