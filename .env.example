# Copie para .env se for rodar fora do docker-compose (ex.: bun run start:dev
# com Postgres/LocalStack/Keycloak já subidos via `docker compose up postgres localstack keycloak`).

DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
WAGER_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
WAGERING_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wagering-events.fifo

KEYCLOAK_JWKS_URL=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8080/realms/wagering
KEYCLOAK_AUDIENCE=wagering-api

PORT=3000
